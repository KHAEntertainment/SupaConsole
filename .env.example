# App URLs
APP_URL=https://supaconsole.example.com
NEXTAUTH_URL=https://supaconsole.example.com
NEXTAUTH_SECRET=replace-with-random-urlsafe-32+chars
AUTH_TRUST_HOST=true

# Registration control
# When unset or false, only the first user can register (bootstrap mode).
# Set to 'true' to allow open registration.
# ALLOW_REGISTRATION=true

# Database (defaults to SQLite file inside the container)
DATABASE_URL=file:/app/data/db.sqlite

# Supabase Core repo to clone
SUPABASE_CORE_REPO_URL=https://github.com/supabase/supabase

# Git ref (tag, branch or commit SHA) of the Supabase release to clone.
# Initialize pins the checkout to this ref; if supabase-core/ already exists at
# a different ref, Initialize reports the mismatch instead of re-cloning.
SUPABASE_CORE_REF=self-hosted/v0.8.2

# Docker access method (pick ONE below)
# If using docker-socket-proxy:
DOCKER_HOST=http://docker-proxy:2375
# If mounting /var/run/docker.sock directly, leave DOCKER_HOST unset.

# Optional: name of your Traefik network for the standard compose
TRAEFIK_NETWORK=traefik
TRAEFIK_RESOLVER=letsencrypt
TRAEFIK_HOST=supaconsole.example.com
